.ai-analysis-page {
  max-width: 1400px;
  margin: 0 auto;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.page-header h1 {
  font-size: 26px;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.5px;
}

.page-subtitle {
  font-size: 14px;
  color: #64748b;
  margin-top: 2px;
}

.header-badges {
  display: flex;
  gap: 10px;
}

.badge {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 14px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
}

.badge-ai {
  background: #e0e7ff;
  color: #4f46e5;
}

.badge-rag {
  background: #dcfce7;
  color: #16a34a;
}

.processing-steps-bar {
  display: flex;
  gap: 8px;
  background: white;
  padding: 12px 20px;
  border-radius: 12px;
  border: 1px solid #e9edf2;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.step {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #94a3b8;
}

.step.complete {
  color: #16a34a;
}

.step .step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #f1f3f6;
  font-size: 10px;
  font-weight: 600;
  color: #94a3b8;
}

.step.complete .step-num {
  background: #dcfce7;
  color: #16a34a;
}

.step-label {
  font-weight: 500;
}

.analysis-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 20px;
}

.document-viewer {
  background: white;
  border-radius: 12px;
  border: 1px solid #e9edf2;
  overflow: hidden;
}

.viewer-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  border-bottom: 1px solid #f1f3f6;
  font-size: 14px;
  font-weight: 500;
  color: #0f172a;
}

.viewer-content {
  padding: 20px;
  max-height: 500px;
  overflow-y: auto;
}

.document-text {
  font-size: 14px;
  line-height: 1.8;
  color: #1a1a2e;
}

.highlighted {
  background: #fef3c7;
  padding: 1px 4px;
  border-radius: 3px;
  font-weight: 500;
}

.legend {
  display: flex;
  gap: 16px;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid #f1f3f6;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #64748b;
}

.legend-color {
  width: 16px;
  height: 16px;
  border-radius: 4px;
}

.extraction-results {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.extraction-results h3 {
  font-size: 15px;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 4px;
}

.extraction-card {
  background: white;
  border-radius: 12px;
  padding: 16px 20px;
  border: 1px solid #e9edf2;
}

.extraction-card h4 {
  font-size: 13px;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin-bottom: 10px;
}

.extraction-item {
  display: flex;
  justify-content: space-between;
  padding: 4px 0;
  font-size: 14px;
}

.extraction-item .label {
  color: #64748b;
}

.extraction-item .value {
  color: #0f172a;
  font-weight: 500;
}

.extraction-card.highlight-card {
  border-color: #4f46e5;
  background: #f8f7ff;
}

.highlight-value {
  color: #4f46e5 !important;
}

.evidence-panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.evidence-panel h3 {
  font-size: 15px;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 4px;
}

.evidence-card {
  background: white;
  border-radius: 12px;
  padding: 18px 20px;
  border: 1px solid #e9edf2;
}

.evidence-header {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid #f1f3f6;
}

.evidence-icon {
  color: #4f46e5;
}

.evidence-source {
  display: flex;
  gap: 8px;
  font-size: 13px;
  margin-bottom: 4px;
}

.source-label {
  color: #64748b;
  font-weight: 500;
  min-width: 70px;
}

.source-value {
  color: #0f172a;
}

.evidence-text {
  margin: 10px 0;
  padding: 10px 14px;
  background: #f8f9fc;
  border-radius: 6px;
  border-left: 3px solid #4f46e5;
}

.evidence-text p {
  font-size: 13px;
  color: #1a1a2e;
  margin-top: 4px;
  font-style: italic;
}

.evidence-confidence {
  margin: 10px 0;
}

.confidence-label {
  font-size: 13px;
  color: #64748b;
  font-weight: 500;
}

.confidence-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 4px;
  background: #f1f3f6;
  border-radius: 20px;
  height: 6px;
  position: relative;
}

.confidence-fill {
  height: 100%;
  border-radius: 20px;
  background: linear-gradient(90deg, #22c55e, #4f46e5);
}

.confidence-value {
  font-size: 13px;
  font-weight: 600;
  color: #0f172a;
  position: absolute;
  right: -40px;
}

.evidence-reasoning {
  margin: 10px 0;
}

.evidence-reasoning p {
  font-size: 13px;
  color: #1a1a2e;
  margin-top: 4px;
  background: #f0f4ff;
  padding: 10px 14px;
  border-radius: 6px;
}

.btn-view-source {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 16px;
  background: #f1f3f6;
  border: none;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  color: #4f46e5;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: 8px;
}

.btn-view-source:hover {
  background: #e0e7ff;
}

.verification-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: #dcfce7;
  border-radius: 8px;
  color: #16a34a;
  font-size: 14px;
  font-weight: 500;
}

@media (max-width: 1200px) {
  .analysis-grid {
    grid-template-columns: 1fr;
  }
  
  .document-viewer .viewer-content {
    max-height: 300px;
  }
}

@media (max-width: 768px) {
  .header-badges {
    display: none;
  }
  
  .processing-steps-bar {
    flex-direction: column;
    gap: 4px;
  }
}